# MongoDB connection string (required)
# Get one free from https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/sehatsaathi

# Secret used to sign login tokens (any long random string)
SESSION_SECRET=change-this-to-a-long-random-string

# Google Gemini AI API key (for medicine/prescription/report scanning)
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server port (default: 3000)
PORT=3000
